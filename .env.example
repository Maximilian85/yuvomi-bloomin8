# Copy to .env locally, never commit real secrets.
# Internal URL reachable from the relay container:
YUVOMI_URL=http://192.168.0.2:3000
# Yuvomi Settings > Household > API access: calendar read-only token
YUVOMI_API_TOKEN=replace-with-yuvomi-calendar-read-token
# Keep the existing device token configured on your BLOOMIN8 frame.
EINK_PULL_TOKEN=replace-with-at-least-24-random-characters
EINK_DEVICE_ID=
# Synology LAN URL reachable by the BLOOMIN8 frame:
EINK_PUBLIC_URL=http://192.168.0.2:8088
EINK_INTERVAL_MINUTES=30
EINK_NIGHT_START=21
EINK_NIGHT_END=6
TZ=Europe/Berlin
