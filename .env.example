# Copy to .env; do not commit secrets
EINK_PULL_TOKEN=replace-with-at-least-24-random-characters
# Optional restriction after identifying device from logs
EINK_DEVICE_ID=
# IP of your Linux Mint host reachable by the frame
EINK_PUBLIC_URL=http://192.168.1.50:8088
EINK_INTERVAL_MINUTES=30
EINK_NIGHT_START=21
EINK_NIGHT_END=6
TZ=Europe/Berlin
