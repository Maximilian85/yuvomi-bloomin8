    "navigation": "standard",
    "responsive": "standard"
  },
  "capabilities": {
    "permissions": {
      "module": {
        "label": "BLOOMIN8",
        "icon": "monitor"
      }
    },
    "api": {
      "prefix": "/api/extensions/yuvomi-bloomin8"
    }
