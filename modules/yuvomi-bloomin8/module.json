{
  "manifestVersion": 1,
  "id": "yuvomi-bloomin8",
  "name": "BLOOMIN8 E-Ink",
  "version": "1.9.0",
  "description": "Korrigierte Dashboard-Vorlagen, optionales Immich-Foto und besser lesbarer Kalender",
  "entry": "index.js",
  "style": "style.css",
  "settings": {
    "entry": "settings.js",
    "sections": [
      "household"
    ]
  },
  "icon": "monitor",
  "accent": "#49636D",
